{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Burnrate",
  "version": "1.0.0",
  "identifier": "dev.burnrate.app",
  "build": { "beforeDevCommand": "npm run dev", "devUrl": "http://localhost:5173", "frontendDist": "../dist" },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      { "label": "main", "title": "", "width": 380, "height": 560, "resizable": false, "center": true, "decorations": false, "transparent": false, "visible": false, "skipTaskbar": false }
    ],
    "security": { "csp": "default-src 'self'; connect-src 'self' https://api.anthropic.com https://platform.claude.com https://chatgpt.com https://auth.openai.com https://cli-chat-proxy.grok.com https://cursor.com https://opencode.ai" }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "startMenuFolder": "Burnrate",
        "installerHooks": "./windows/installer-hooks.nsh"
      }
    }
  }
}
