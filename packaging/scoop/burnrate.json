{
  "version": "1.0.0",
  "description": "Local usage limits for AI coding providers",
  "homepage": "https://github.com/tovi2101/burnrate",
  "license": "MIT",
  "architecture": {
    "64bit": {
      "url": "https://github.com/tovi2101/burnrate/releases/download/v1.0.0/Burnrate_1.0.0_x64-setup.exe",
      "hash": "skip"
    }
  },
  "installer": {
    "args": ["/S", "/CURRENTUSER"]
  },
  "uninstaller": {
    "script": "if ($cmd -and (Test-Path $cmd)) { Start-Process -Wait $cmd -ArgumentList '/S' }"
  },
  "shortcuts": [["Burnrate.exe", "Burnrate"]]
}
